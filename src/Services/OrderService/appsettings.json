{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OrderConnection": "Server=localhost;Database=PRM_Order;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=PRM_Order;Trusted_Connection=true;TrustServerCertificate=true;",
    "Provider": "SqlServer",
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": false,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3
  },
  "MessageQueue": {
    "Provider": "RabbitMQ",
    "RabbitMQ": {
      "Exchange": "order-exchange",
      "RoutingKey": "order.viewed",
      "Queue": "product-order-queue",
      "MaxRetries": 3
    }
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Port": 5672
  },
  "RabbitMqSettings": {
    "Exchange": "order-exchange",
    "RoutingKey": "order.viewed",
    "Queue": "product-order-queue",
    "MaxRetries": 3
  },
  "AllowedHosts": "*"
}